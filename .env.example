# Copy to .env.local; never commit actual credentials.
# Public design previews work with all values unset.
DATABASE_URL=
TPA_DATABASE_NAME=
DATABASE_SSL=false
DATABASE_CA_FILE=
# Managed production certificate; do not set DATABASE_CA_FILE in cloud deployments.
DATABASE_CA_PEM=
DATABASE_TLS_SERVERNAME=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing private bucket; no public R2 domain is required.
# Local only: read the original supplied credential file transiently.
# Never copy its contents here. Production storage is disabled pending secret setup.
R2_BUCKET_NAME=tpa-private-documents
CLOUDFLARE_CREDENTIAL_FILE=
# Production: independent bucket-scoped credential in hosting secret settings.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Password recovery: verified transactional sender (TLS required).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Managed secrets only. Enable after verifying the TPA sending domain in Resend.
RESEND_API_KEY=
RESEND_DOMAIN_VERIFIED=false

# Durable communications: generated runtime credentials belong only in managed secrets.
# Resend exposes full_access for receiving/usage, not a receiving-only permission.
RESEND_RECEIVING_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_OPERATIONS_ENABLED=false
# Coordinated onboarding uses the same worker/webhook; disabled until its own acceptance.
ONBOARDING_ENABLED=false

# Isolated loopback acceptance only; never routes normal email to test recipients.
TPA_MAIL_SINK=false
