# Copy to .env.local; never commit actual credentials.
# Public design previews work with all values unset.
DATABASE_URL=
TPA_DATABASE_NAME=
DATABASE_SSL=false

# Existing private bucket; no public R2 domain is required.
# Use credentials restricted to the selected TPA bucket.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
